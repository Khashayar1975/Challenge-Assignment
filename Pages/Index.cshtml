@page
@model IndexModel

@{
    ViewData["Title"] = "Server Time";
}

<div class="text-center">

    <h1>Welcome to My ASP.NET Core Application</h1>

    <h2>My First Azure Web Application</h2>

    <h3>The current server time is:</h3>

    <p>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>

</div>